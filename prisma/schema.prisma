// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Room {
  WHOLE_HOUSE
  HALLWAY
  SITTING_ROOM
  KITCHEN
  GAMES_ROOM
  UNDERSTAIR_CUPBOARD
  LANDING
  SPARE_ROOM_1
  SPARE_ROOM_2
  MASTER_BEDROOM
  BATHROOM_1
  BATHROOM_2
  BACK_GARDEN
  FRONT_GARDEN
  DRIVEWAY
  ATTIC
}

enum Priority {
  MUST_HAVE
  WOULD_LIKE
  SOMEDAY
}

// A job to do, or a thing to buy. Both share every field — a job can cost
// money (a tradesperson, materials) and a purchase can have steps.
enum Kind {
  TASK
  BUY
}

enum Status {
  TODO
  DOING
  DONE
}

enum Repeat {
  WEEKLY
  MONTHLY
  QUARTERLY
  TWICE_YEARLY
  YEARLY
}

model Item {
  id       String   @id @default(cuid())
  title    String
  kind     Kind     @default(TASK)
  room     Room     @default(WHOLE_HOUSE)
  priority Priority @default(WOULD_LIKE)
  status   Status   @default(TODO)

  // Cost is optional — plenty of jobs are free. A range is estimatedPrice to
  // estimateMax; planning uses the top of the range so it never under-promises.
  estimatedPrice Float?
  estimateMax    Float?
  isQuote        Boolean @default(false)
  actualPrice    Float?

  // Free text so it can be either of them, "Both", or a tradesperson.
  assignee String?
  dueDate  DateTime? @db.Date
  // When the guarantee or warranty on it runs out; the calendar feed warns
  // a month ahead.
  warrantyUntil DateTime? @db.Date
  // Loose grouping tag ("Kitchen reno"). Replaced the old user-created lists.
  project  String?
  // Product pages, quotes, videos — a job often needs several.
  links    String[] @default([])
  notes    String?

  // Repeating jobs: finishing one creates the next, which points back here
  // so undoing the finish can take the new one away again.
  repeat        Repeat?
  spawnedFromId String?
  // Pinned by hand: "we've decided this is next", ahead of the automatic order.
  pinned        Boolean @default(false)
  // What finishing this took out of the pot (its price less any stages
  // already paid), so reopening puts back exactly that. Null: not charged,
  // because it isn't done or the pot wasn't in use when it was ticked off.
  potCharge     Float?

  addedBy     String
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps    Step[]
  quotes   Quote[]
  comments Comment[]
  aiJobs   AiJob[]

  @@index([status])
  @@index([priority])
  @@index([room])
}

// One line of an item's checklist ("buy paint", "first coat", …).
model Step {
  id        String   @id @default(cuid())
  itemId    String
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  // A stage can have its own price, supplier link and details. When any step
  // has a cost, the item's estimate is the steps' total.
  cost      Float?
  link      String?
  notes     String?
  // Stage payments: ticking a costed step spends it from the pot. Null: not
  // charged (not done, or ticked before the pot was in use).
  potCharge Float?
  doneAt    DateTime?
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Single-row table holding the household's shared settings.
model Settings {
  id              Int       @id @default(1)
  // The pot: money available right now. Spending on an item comes out of it.
  budgetAvailable Float     @default(0)
  // Off until someone sets the pot or a monthly saving: before then, ticking
  // things off doesn't spend from a pot nobody is keeping.
  potTracked      Boolean   @default(false)
  monthlySaving   Float     @default(0)
  // Names that have used the app — offered at the name gate and as assignees.
  members         String[]  @default([])
  movedInOn       DateTime? @db.Date
  // The last time the monthly saving went in, and by whom — so the other
  // person can see it's been done before adding it a second time.
  lastPaydayOn    DateTime? @db.Date
  lastPaydayBy    String?
  // When the AI worker last asked for work, so the app can say honestly
  // whether anything is listening for its questions.
  workerSeenAt    DateTime?
}

// A price from someone who'd do the job. Choosing one sets the item's cost.
model Quote {
  id        String   @id @default(cuid())
  itemId    String
  from      String
  amount    Float
  note      String?
  chosen    Boolean  @default(false)
  addedBy   String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// A short update on an item — "rang them, waiting for a callback".
model Comment {
  id        String   @id @default(cuid())
  itemId    String
  author    String
  text      String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// What Claude is asked to do with an item. Research and finding products are
// one tap; ASK carries the household's own question.
enum AiJobKind {
  RESEARCH_ITEM
  FIND_PRODUCT
  ASK
}

// QUEUED until a worker claims it, RUNNING while Claude works, then DONE (a
// suggestion waiting for someone) or FAILED. ACCEPTED and DISMISSED have been
// dealt with, and no longer show.
enum AiJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  ACCEPTED
  DISMISSED
}

// A question for Claude about an item. The app only queues it: a worker on
// someone's own computer runs Claude Code on their subscription, and the
// answer comes back as a suggestion that a person chooses to use.
model AiJob {
  id          String      @id @default(cuid())
  itemId      String?
  kind        AiJobKind
  question    String?
  status      AiJobStatus @default(QUEUED)
  // The validated suggestion (see lib/ai.ts for its shape).
  result      Json?
  error       String?
  // Claims so far. A worker that dies mid-job leaves it RUNNING; it's handed
  // out again, but not forever.
  attempts    Int         @default(0)
  requestedBy String
  claimedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime    @default(now())

  item Item? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([itemId])
}

// Failed PIN attempts, per IP and overall, so the PIN can't be guessed by
// brute force. A row starts afresh once its window has passed.
model LoginThrottle {
  key         String   @id
  failures    Int      @default(0)
  windowStart DateTime @default(now())
}
