// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Room {
  WHOLE_HOUSE
  HALLWAY
  SITTING_ROOM
  KITCHEN
  GAMES_ROOM
  UNDERSTAIR_CUPBOARD
  LANDING
  SPARE_ROOM_1
  SPARE_ROOM_2
  MASTER_BEDROOM
  BATHROOM_1
  BATHROOM_2
  BACK_GARDEN
  FRONT_GARDEN
  DRIVEWAY
  ATTIC
}

enum Priority {
  MUST_HAVE
  WOULD_LIKE
  SOMEDAY
}

// A job to do, or a thing to buy. Both share every field — a job can cost
// money (a tradesperson, materials) and a purchase can have steps.
enum Kind {
  TASK
  BUY
}

enum Status {
  TODO
  DOING
  DONE
}

enum Repeat {
  WEEKLY
  MONTHLY
  QUARTERLY
  TWICE_YEARLY
  YEARLY
}

model Item {
  id       String   @id @default(cuid())
  title    String
  kind     Kind     @default(TASK)
  room     Room     @default(WHOLE_HOUSE)
  priority Priority @default(WOULD_LIKE)
  status   Status   @default(TODO)

  // Cost is optional — plenty of jobs are free. A range is estimatedPrice to
  // estimateMax; planning uses the top of the range so it never under-promises.
  estimatedPrice Float?
  estimateMax    Float?
  isQuote        Boolean @default(false)
  actualPrice    Float?

  // Free text so it can be either of them, "Both", or a tradesperson.
  assignee String?
  dueDate  DateTime? @db.Date
  // When the guarantee or warranty on it runs out; the calendar feed warns
  // a month ahead.
  warrantyUntil DateTime? @db.Date
  // Loose grouping tag ("Kitchen reno"). Replaced the old user-created lists.
  project  String?
  // Product pages, quotes, videos — a job often needs several.
  links    String[] @default([])
  notes    String?

  // Repeating jobs: finishing one creates the next, which points back here
  // so undoing the finish can take the new one away again.
  repeat        Repeat?
  spawnedFromId String?
  // Pinned by hand: "we've decided this is next", ahead of the automatic order.
  pinned        Boolean @default(false)
  // What finishing this took out of the pot (its price less any stages
  // already paid), so reopening puts back exactly that. Null: not charged,
  // because it isn't done or the pot wasn't in use when it was ticked off.
  potCharge     Float?

  addedBy     String
  completedAt DateTime?
  completedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  steps    Step[]
  quotes   Quote[]
  comments Comment[]
  photos   Photo[]
  aiJobs   AiJob[]
  // Where it's pinned on a planning board, if anywhere.
  pieces   BoardPiece[]
  // Split between the two of you after one paid for it.
  payments Payment[]

  @@index([status])
  @@index([priority])
  @@index([room])
}

// One line of an item's checklist ("buy paint", "first coat", …).
model Step {
  id        String   @id @default(cuid())
  itemId    String
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  // A stage can have its own price, supplier link and details. When any step
  // has a cost, the item's estimate is the steps' total.
  cost      Float?
  link      String?
  notes     String?
  // Stage payments: ticking a costed step spends it from the pot. Null: not
  // charged (not done, or ticked before the pot was in use).
  potCharge Float?
  doneAt    DateTime?
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// Single-row table holding the household's shared settings.
model Settings {
  id              Int       @id @default(1)
  // The pot: money available right now. Spending on an item comes out of it.
  budgetAvailable Float     @default(0)
  // Off until someone sets the pot or a monthly saving: before then, ticking
  // things off doesn't spend from a pot nobody is keeping.
  potTracked      Boolean   @default(false)
  monthlySaving   Float     @default(0)
  // Names that have used the app — offered at the name gate and as assignees.
  members         String[]  @default([])
  movedInOn       DateTime? @db.Date
  // The last time the monthly saving went in, and by whom — so the other
  // person can see it's been done before adding it a second time.
  lastPaydayOn    DateTime? @db.Date
  lastPaydayBy    String?
  // When the AI worker last asked for work, so the app can say honestly
  // whether anything is listening for its questions.
  workerSeenAt    DateTime?
  // Bin[] (src/lib/bins.ts): each bin's colour, how often it goes out, and
  // any one-off moved or missed collections.
  bins            Json      @default("[]")
  // The day of the month (1-28) the morning reminder asks for meter
  // readings; null for no reminder.
  meterDay        Int?
}

// Money one of the household owes the other: usually a bill one of them paid,
// half of which is the other's. Open until it's paid. Nothing to do with the
// pot: settling up moves money between them, not out of the house savings.
model Payment {
  id          String    @id @default(cuid())
  description String
  // What's owed.
  amount      Float
  // The whole bill, when it was split half each; null when the amount was
  // owed as it stands.
  billTotal   Float?
  owedBy      String
  owedTo      String
  billedOn    DateTime  @db.Date
  // When it was paid, which needn't be the day it was ticked off.
  paidOn      DateTime? @db.Date
  paidBy      String?
  // Paid together in one settle-up: every payment it cleared shares this.
  settlementId String?
  // The thing on the list this was half of, when a purchase was split.
  itemId      String?
  addedBy     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([paidOn])
  @@index([settlementId])
  @@index([itemId])
}

enum Meter {
  GAS
  ELECTRIC
  WATER
}

// One reading of one meter, for the supplier and to see how much you use.
model MeterReading {
  id      String   @id @default(cuid())
  meter   Meter
  value   Float
  takenOn DateTime @db.Date
  // A photo of the dial, stored like an item's photos under this id, in case
  // a bill is ever disputed.
  photoId String?
  takenBy String
  createdAt DateTime @default(now())

  @@index([meter, takenOn])
}

// Whether you'd have a tradesperson back.
enum Verdict {
  YES
  NOT_SURE
  NO
}

// Someone who's quoted for or done a job, to call again (or not). Their
// quotes and jobs are found by name, from quotes and who a job is with.
model Tradesperson {
  id        String   @id @default(cuid())
  name      String
  trade     String?
  phone     String?
  email     String?
  notes     String?
  verdict   Verdict?
  addedBy   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Something on the calendar that isn't a job: a gig, a family do, a
// birthday. A day, maybe a time or a last day, and maybe again every week,
// month or year.
model CalendarEvent {
  id        String    @id @default(cuid())
  title     String
  date      DateTime  @db.Date
  // The last day, for something that runs over several.
  endDate   DateTime? @db.Date
  // "19:30", or none for all day.
  time      String?
  repeat    Repeat?
  notes     String?
  addedBy   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([date])
}

// A list printed to tick off on paper. It keeps the lines as printed, so
// ticking it back in later shows exactly what was on the page, in the same
// order and numbering, even after the list has moved on.
model PrintOut {
  id        String   @id @default(cuid())
  title     String
  createdBy String
  // PrintLine[] (src/lib/printouts.ts): item, optional step, text, group.
  lines     Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A phone that has turned on notifications. Tagged with whose phone it is,
// so a change only buzzes the other person's.
model PushSubscription {
  id        String   @id @default(cuid())
  // The push service's address for this phone; unique per browser install.
  endpoint  String   @unique
  p256dh    String
  auth      String
  member    String
  createdAt DateTime @default(now())

  @@index([member])
}

// A price from someone who'd do the job. Choosing one sets the item's cost.
model Quote {
  id        String   @id @default(cuid())
  itemId    String
  from      String
  amount    Float
  note      String?
  chosen    Boolean  @default(false)
  addedBy   String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// A short update on an item — "rang them, waiting for a callback".
model Comment {
  id        String   @id @default(cuid())
  itemId    String
  author    String
  text      String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// A photo of the thing or the job: the product, the wall before, the quote
// on paper. The image itself lives in blob storage under the photo's id (see
// lib/photo-store.ts), as a full-size copy and a small one for lists.
model Photo {
  id        String   @id
  itemId    String
  // The full-size copy's pixels, so it can be laid out before it loads.
  width     Int
  height    Int
  addedBy   String
  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// A planning board: a canvas of ideas and things from the list, in three
// bands (Ideas, Maybe, Decided) that a piece moves through as it's decided.
// Optionally about one room, whose paint it wears.
model Board {
  id        String   @id @default(cuid())
  name      String
  room      Room?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pieces BoardPiece[]
}

enum PieceKind {
  PHOTO
  LINK
  ITEM
  NOTE
  SWATCH
}

// One thing on a board. Position and size are in board units (CSS pixels at
// full size); which band it's in follows from x (lib/boards.ts).
model BoardPiece {
  id      String    @id @default(cuid())
  boardId String
  kind    PieceKind
  x       Float
  y       Float
  w       Float
  h       Float
  // Stacking: higher is in front.
  z       Int       @default(0)
  // The picture (a photo, or a shop's product image), stored like an item's
  // photos under this id. Width over height, for laying it out.
  imageId String?
  aspect  Float?
  // An item from the list, or what this idea became when it was added to it.
  // Null on an ITEM piece means the item has since been deleted.
  itemId  String?
  url     String?
  title   String?
  price   Float?
  site    String?
  text    String?
  // A swatch's colour, as #rrggbb.
  color   String?
  addedBy   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  item  Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([boardId])
  @@index([itemId])
}

// What Claude is asked to do with an item. Research and finding products are
// one tap; ASK carries the household's own question.
enum AiJobKind {
  RESEARCH_ITEM
  FIND_PRODUCT
  ASK
  // Revise an existing item in place, as the household asked.
  IMPROVE
}

// QUEUED until a worker claims it, RUNNING while Claude works, then DONE (a
// suggestion waiting for someone) or FAILED. ACCEPTED and DISMISSED have been
// dealt with, and no longer show.
enum AiJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  ACCEPTED
  DISMISSED
}

// A question for Claude about an item. The app only queues it: a worker on
// someone's own computer runs Claude Code on their subscription, and the
// answer comes back as a suggestion that a person chooses to use.
model AiJob {
  id          String      @id @default(cuid())
  itemId      String?
  kind        AiJobKind
  question    String?
  // Added from quick add with "Ask Claude": the answer fills the item in
  // directly instead of waiting as a suggestion.
  autofill    Boolean     @default(false)
  status      AiJobStatus @default(QUEUED)
  // The validated suggestion (see lib/ai.ts for its shape).
  result      Json?
  // An IMPROVE job that changed its item: what it was before, so the change
  // can be undone (see ImproveUndo in lib/ai.ts). Null when nothing was applied.
  undo        Json?
  error       String?
  // Claims so far. A worker that dies mid-job leaves it RUNNING; it's handed
  // out again, but not forever.
  attempts    Int         @default(0)
  requestedBy String
  claimedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime    @default(now())

  item Item? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([itemId])
}

// Failed PIN attempts, per IP and overall, so the PIN can't be guessed by
// brute force. A row starts afresh once its window has passed.
model LoginThrottle {
  key         String   @id
  failures    Int      @default(0)
  windowStart DateTime @default(now())
}
