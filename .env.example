# Copy this file to .env and fill in your own values. See README.md for the
# full local setup and deployment walkthrough.

# Local dev default: Prisma's own local Postgres server (`npx prisma dev`).
# In production, replace with your Neon (or other Postgres) connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Local-only workaround for a `prisma dev` concurrency quirk — see the
# comment in src/lib/prisma.ts. Leave this unset in production.
DATABASE_POOL_MAX="1"

# The shared PIN you and your partner use to unlock the app.
HOUSE_PIN="changeme"

# Long random string used to sign the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-generated-random-string"

# Optional: Amazon prices for pasted links and Ask Claude, from rainforestapi.com.
# Set it on Vercel too. Each lookup spends one credit.
RAINFOREST_API_KEY=""

# Optional: notifications on your phones. Generate a key pair once with:
#   npx web-push generate-vapid-keys
# and set the same pair on Vercel (a new pair stops every phone's notifications
# until it's turned on again).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Set on Vercel only: Vercel sends it to the daily due-date reminder, which
# refuses any other caller. Any long random string.
CRON_SECRET=""

# Photos on items: set on Vercel by connecting a Blob store to the project
# (Storage → Create → Blob, private). Leave it unset locally and photos are
# saved in .photos/ instead.
BLOB_READ_WRITE_TOKEN=""
